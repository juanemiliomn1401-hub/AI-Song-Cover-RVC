codigo = '''
from pydub import AudioSegment

entrada = "/content/tu_audio.mp3"
salida = "/content/AEIOU_RVC_40k_mono.wav"

audio = AudioSegment.from_file(entrada)
audio = audio.set_channels(1)
audio = audio.set_frame_rate(40000)

audio.export(
    salida,
    format="wav",
    parameters=["-acodec", "pcm_s16le"]
)

print("Listo:", salida)
'''

with open("/content/convertir_audio.py", "w") as f:
    f.write(codigo)

print("Archivo guardado")
